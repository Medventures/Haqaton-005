# LM Studio (OpenAI-compatible). Start the server in LM Studio: Developer -> Start Server (port 1234)
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=qwen2.5-7b-instruct
JWT_SECRET=change-me-hackathon
# Operators: login1:password1,login2:password2 (empty -> demo operator1/operator1, operator2/operator2)
OPERATORS=
# APP_ENV=production refuses to start with the default/short JWT_SECRET (needs >= 32 chars)
# APP_ENV=production
# TRUST_PROXY=true takes the client IP for login rate limiting from X-Forwarded-For
# TRUST_PROXY=true
