# LM Studio (OpenAI-compatible). Start the server in LM Studio: Developer -> Start Server (port 1234)
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=qwen2.5-7b-instruct
JWT_SECRET=change-me-hackathon
# Operators: login1:password1,login2:password2 (empty -> demo operator1/operator1, operator2/operator2)
OPERATORS=
# APP_ENV=production refuses to start with the default/short JWT_SECRET (needs >= 32 chars)
# APP_ENV=production
# TRUST_PROXY=true takes the client IP for login rate limiting from X-Forwarded-For
# TRUST_PROXY=true
# MIS integration (/api/integration/*, header X-API-Key). Empty -> integration endpoints return 503
# INTEGRATION_API_KEY=generate-a-long-random-key

# --- Optional: LLM inside Docker Compose (llama.cpp, data never leaves the host) ---
# Put a GGUF file (e.g. Qwen2.5-7B-Instruct Q4_K_M) into ./models, then run
#   docker compose --profile llm up -d
# and switch the backend to the in-compose server:
# LLM_BASE_URL=http://llm:8080/v1
# LLM_MODEL=local            # any string: llama.cpp serves the single loaded model
# LLM_GGUF=qwen2.5-7b-instruct-q4_k_m.gguf   # file name inside LLM_MODELS_DIR
# LLM_MODELS_DIR=./models    # host directory mounted read-only at /models
